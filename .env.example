# =============================================================================
# E2M Customer Success Platform - Root Environment Variables
# Copy this file to .env before starting Docker Compose:
# cp .env.example .env
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=e2m_db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend API Configuration
BACKEND_PORT=8000
JWT_SECRET_KEY=e2m-super-secure-secret-key-production-change-me-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=true

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@e2m.com
EMAILS_FROM_NAME="E2M Customer Success"
EMAIL_NOTIFICATIONS_ENABLED=true

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

